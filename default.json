{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "schedule": ["before 3am on Monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "description": "Auto-merge patch and digest updates",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "groupName": "dependency updates (patches)"
    },
    {
      "description": "Group minor updates for review",
      "matchUpdateTypes": ["minor"],
      "groupName": "dependency updates (minor)"
    },
    {
      "description": "Digest-pin Dockerfile base images; the digest auto-merge rule keeps them current",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["tobias-dev"]
  }
}
